generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

model User {
  id             String    @id @default(uuid())
  username       String    @unique
  password_hash  String
  role           Role      @default(VIEWER)
  email          String?
  full_name      String?
  is_active      Boolean   @default(true)
  last_active_at DateTime?
  preferences    Json?     @default("{}")
  created_at     DateTime  @default(now())
}

enum AreaType {
  SITE
  BUILDING
  FLOOR
  ROOM
}

model Area {
  id          String    @id @default(uuid())
  name        String
  type        AreaType
  parent_id   String?
  parent      Area?     @relation("AreaChildren", fields: [parent_id], references: [id])
  children    Area[]    @relation("AreaChildren")
  code        String?
  description String?
  is_active   Boolean   @default(true)
  image_path  String?
  map_x       Float?
  map_y       Float?
  created_at  DateTime  @default(now())
  sensors     Sensor[]
  lighting_rollups RoomLightingRollup[]
}

enum SensorKind {
  MOTION
  LIGHT
}

model Sensor {
  id           String       @id @default(uuid())
  sensor_key   String       @unique
  name         String
  kind         SensorKind
  room_area_id String?
  room         Area?        @relation(fields: [room_area_id], references: [id])
  is_active    Boolean      @default(true)
  metadata     Json?
  created_at   DateTime     @default(now())
  events       SensorEvent[]

  @@unique([room_area_id, kind])
}

model SensorEvent {
  id         String   @id @default(uuid())
  sensor_id  String
  sensor     Sensor   @relation(fields: [sensor_id], references: [id])
  value      String
  ts         DateTime
  raw        Json?
  created_at DateTime @default(now())

  @@index([sensor_id, ts(sort: Desc)])
  @@index([ts(sort: Desc)])
}

// Pre-computed daily wasted-lighting per room (Tier-2 optimization).
// Derived from SensorEvent by prisma/rollups-rebuild.js; safe to drop & rebuild.
model RoomLightingRollup {
  id                String   @id @default(uuid())
  room_area_id      String
  room              Area     @relation(fields: [room_area_id], references: [id])
  date              DateTime // day bucket (UTC midnight)
  wasted_minutes    Int      @default(0)
  lights_on_minutes Int      @default(0)
  event_count       Int      @default(0)
  computed_at       DateTime @default(now())

  @@unique([room_area_id, date])
  @@index([date])
}